# ===================================================================
# CodeCraft Platformasi & Telegram Bot — Muhit O'zgaruvchilari (.env)
# ===================================================================
# Ushbu fayldan nusxa olib, '.env' nomli yangi fayl yarating yoki
# Render.com Dashboard -> "Environment Variables" bo'limiga kiriting.
# Diqqat: .env faylini hech qachon GitHub yoki ochiq joylarga yuklamang!
# ===================================================================

# 1. Server & Tizim sozlamalari
PORT=5000
NODE_ENV=production
JWT_SECRET=codecraft-super-secret-jwt-key-2026-production

# 2. Telegram Bot (@CodeCraftUzBot) sozlamalari
# @BotFather dan olingan bot tokeni:
TELEGRAM_BOT_TOKEN=8226228135:AAFVj78_5wIj1-eYPRRuQWXIzFN-EW0_iis

# Admin Telegram Chat ID (ixtiyoriy, agar bo'sh qolsa birinchi /start bosgan chatga yuboriladi):
TELEGRAM_CHAT_ID=

# 3. SMS Gateway sozlamalari (O'zbekiston +998 raqamlariga haqiqiy SMS yuborish uchun)
# -------------------------------------------------------------------
# Variant A: Eskiz.uz (Tavsiya etiladi - https://my.eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_TOKEN=
ESKIZ_FROM=4546

# Variant B: TextBee.dev (Android telefon orqali bepul SMS - https://textbee.dev)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Variant C: Twilio (Xalqaro SMS Gateway - https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Variant D: Maxsus SMS API Shlyuz
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
