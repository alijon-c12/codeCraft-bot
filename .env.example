# Ma'lumotlar bazasi (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educenter?schema=public"

# Server sozlamalari
PORT=5000
NODE_ENV="development"
JWT_SECRET="educenter-super-secret-jwt-key-change-in-production"

# To'lov tizimlari (Sandbox / Production)
PAYMENT_MODE="sandbox"
PAYME_MERCHANT_ID="65a1b2c3d4e5f60001234567"
PAYME_SECRET_KEY="sandbox_payme_key"
CLICK_SERVICE_ID="12345"
CLICK_MERCHANT_ID="67890"
CLICK_SECRET_KEY="sandbox_click_key"

# Fayl saqlash (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT="https://s3.educenter.uz"
S3_BUCKET="educenter-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Bildirishnomalar (Telegram Bot & SMTP)
TELEGRAM_BOT_TOKEN="123456789:AAF_sandbox_telegram_bot_token"
TELEGRAM_ADMIN_CHAT_ID="-1001234567890"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@educenter.uz"
SMTP_PASS="sandbox_smtp_password"

# SMS Gateway (O'zbekiston bo'ylab telefon raqamlariga haqiqiy SMS yuborish - Eskiz.uz)
ESKIZ_EMAIL="your-email@example.com"
ESKIZ_PASSWORD="your-eskiz-password"
# Yoki to'g'ridan-to'g'ri token:
# ESKIZ_TOKEN="eyJ0eXAiOiJKV1QiLC..."
# Maxsus SMS Gateway Webhook:
# SMS_GATEWAY_URL="https://sms.provider.uz/api/send"
